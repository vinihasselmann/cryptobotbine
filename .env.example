# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# URL do backend Node.js (Railway em produção, localhost em dev)
VITE_API_URL=http://127.0.0.1:8787

# Chaves RPC para MetaMask / Web3 (opcional — tem fallback público)
REACT_APP_ALCHEMY_KEY=your_key_here
REACT_APP_INFURA_KEY=your_key_here

# ── Backend (Node.js / Railway / EC2) ─────────────────────────────────────────
# Supabase — obtenha em: supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Binance API — obtenha em: binance.com → Perfil → Gestão de API
# Permissões necessárias: "Leitura" + "Spot & Margin Trading"
BINANCE_API_KEY=sua_api_key_aqui
BINANCE_API_SECRET=sua_api_secret_aqui

# Use 'true' para operar no testnet da Binance (recomendado para testes iniciais)
BINANCE_TESTNET=false

# Porta do servidor (Railway/EC2 definem via $PORT)
PORT=8787

# Define 'production' para bind em 0.0.0.0 (obrigatório em servidores)
NODE_ENV=production
